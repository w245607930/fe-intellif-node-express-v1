generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum RefreshSessionStatus {
  ACTIVE
  REVOKED
  REUSED
}

model User {
  id             String           @id @default(cuid()) @db.VarChar(30)
  username       String           @unique(map: "uq_users_username") @db.VarChar(64)
  email          String           @unique(map: "uq_users_email") @db.VarChar(191)
  passwordHash   String           @map("password_hash") @db.VarChar(255)
  status         UserStatus       @default(ACTIVE)
  tokenVersion   Int              @default(0) @map("token_version") @db.UnsignedInt
  lastLoginAt    DateTime?        @map("last_login_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?        @map("deleted_at") @db.DateTime(3)
  roles          UserRole[]
  refreshSessions RefreshSession[]

  @@index([status, deletedAt], map: "idx_users_status_deleted_at")
  @@map("users")
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique(map: "uq_roles_code") @db.VarChar(64)
  name        String           @db.VarChar(128)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?        @map("deleted_at") @db.DateTime(3)
  users       UserRole[]
  permissions RolePermission[]

  @@index([deletedAt], map: "idx_roles_deleted_at")
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid()) @db.VarChar(30)
  code        String           @unique(map: "uq_permissions_code") @db.VarChar(128)
  name        String           @db.VarChar(128)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.VarChar(30)
  roleId    String   @map("role_id") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model RolePermission {
  roleId      String     @map("role_id") @db.VarChar(30)
  permissionId String    @map("permission_id") @db.VarChar(30)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model RefreshSession {
  id                String               @id @default(cuid()) @db.VarChar(30)
  userId            String               @map("user_id") @db.VarChar(30)
  familyId          String               @map("family_id") @db.VarChar(36)
  tokenHash         String               @unique(map: "uq_refresh_sessions_token_hash") @map("token_hash") @db.Char(64)
  status            RefreshSessionStatus @default(ACTIVE)
  expiresAt         DateTime             @map("expires_at") @db.DateTime(3)
  lastUsedAt        DateTime?            @map("last_used_at") @db.DateTime(3)
  revokedAt         DateTime?            @map("revoked_at") @db.DateTime(3)
  revokeReason      String?              @map("revoke_reason") @db.VarChar(128)
  replacedById      String?              @unique(map: "uq_refresh_sessions_replaced_by_id") @map("replaced_by_id") @db.VarChar(30)
  userAgent         String?              @map("user_agent") @db.VarChar(500)
  ipAddress         String?              @map("ip_address") @db.VarChar(45)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshSession?      @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          RefreshSession?      @relation("SessionRotation")

  @@index([userId, status], map: "idx_refresh_sessions_user_status")
  @@index([familyId], map: "idx_refresh_sessions_family_id")
  @@index([expiresAt], map: "idx_refresh_sessions_expires_at")
  @@map("refresh_sessions")
}
